# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://sparks:sparks@localhost:5432/sparks?schema=public"

# Auth.js. Generate a secret with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Microsoft Entra ID (Azure AD) app registration.
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
# Only these email domains may sign in with Microsoft (comma-separated)
AUTH_ALLOWED_EMAIL_DOMAINS="starelectric.ca"

# Dev-only email login (ignored when NODE_ENV=production)
AUTH_DEV_LOGIN=true

# Trimble T&M Billing SQL Server (for scripts/migrate-trimble)
TRIMBLE_SQL_SERVER=""
TRIMBLE_SQL_DATABASE=""
TRIMBLE_SQL_USER=""
TRIMBLE_SQL_PASSWORD=""

# Where uploaded photos and signatures are stored (default ./storage). Back this folder up.
# STORAGE_DIR=""
